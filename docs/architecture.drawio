lAlign=middle;spacingLeft=6;spacingRight=6;whiteSpace=wrap;overflow=hidden;fontSize=11;" vertex="1" parent="e_ADMISSION_FUNNEL"><mxGeometry y="326" width="460" height="48" as="geometry"/></mxCell><mxCell id="e_heuristic_generator (server/generator/heuristic2.go)" value="heuristic_generator (server/generator/heuristic2.go)" style="swimlane;html=1;fontStyle=1;fontSize=13;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#f3f9f2;rounded=1;arcSize=6;shadow=1;" vertex="1" parent="1"><mxGeometry x="1720" y="688" width="460" height="226" as="geometry"/></mxCell><mxCell id="c85" value="&lt;b&gt;entry&lt;/b&gt;&amp;nbsp; BuildProblem / BuildProblemRaw / BuildWordSkeletonRaw -&amp;gt; buildRaw" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;whiteSpace=wrap;overflow=hidden;fontSize=11;" vertex="1" parent="e_heuristic_generator (server/generator/heuristic2.go)"><mxGeometry y="30" width="460" height="26" as="geometry"/></mxCell><mxCell id="c86" value="&lt;b&gt;planConfig&lt;/b&gt;&amp;nbsp; buildCtx: conceptFactor, chooseConcepts, sampleConcepts, clampOperandCap, bracketCap" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;whiteSpace=wrap;overflow=hidden;fontSize=11;" vertex="1" parent="e_heuristic_generator (server/generator/heuristic2.go)"><mxGeometry y="56" width="460" height="48" as="geometry"/></mxCell><mxCell id="c87" value="&lt;b&gt;buildOne&lt;/b&gt;&amp;nbsp; chooseAnswer + recursive expand / splitValue: splitAdd, splitSub, splitMul, splitDiv, splitPercent, splitMulFrac, splitDivFrac, splitDivIntByFrac, splitMulIntWithFrac -&amp;gt; realizeLeaf" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;whiteSpace=wrap;overflow=hidden;fontSize=11;" vertex="1" parent="e_heuristic_generator (server/generator/heuristic2.go)"><mxGeometry y="104" width="460" height="70" as="geometry"/></mxCell><mxCell id="c88" value="&lt;b&gt;equations&lt;/b&gt;&amp;nbsp; buildVariableEquation / buildMissingEquation; fallback" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;whiteSpace=wrap;overflow=hidden;fontSize=11;" vertex="1" parent="e_heuristic_generator (server/generator/heuristic2.go)"><mxGeometry y="174" width="460" height="26" as="geometry"/></mxCell><mxCell id="c89" value="&lt;b&gt;output&lt;/b&gt;&amp;nbsp; mathcore.Node AST via Render; exports VERSION, OptionsError" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;whiteSpace=wrap;overflow=hidden;fontSize=11;" vertex="1" parent="e_heuristic_generator (server/generator/heuristic2.go)"><mxGeometry y="200" width="460" height="26" as="geometry"/></mxCell><mxCell id="e_llm_generator (server/llm_generator)" value="llm_generator (server/llm_generator)" style="swimlane;html=1;fontStyle=1;fontSize=13;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#f3f9f2;rounded=1;arcSize=6;shadow=1;" vertex="1" parent="1"><mxGeometry x="1720" y="950" width="460" height="178" as="geometry"/></mxCell><mxCell id="c90" value="&lt;b&gt;NarrateProblems([]Skeleton)&lt;/b&gt;&amp;nbsp; openai.GPT5Nano; pairNarrations, firstTopicHint, TopicPromptHint" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;whiteSpace=wrap;overflow=hidden;fontSize=11;" vertex="1" parent="e_llm_generator (server/llm_generator)"><mxGeometry y="30" width="460" height="48" as="geometry"/></mxCell><mxCell id="c91" value="&lt;b&gt;ValidateWordProblem(*Problem)&lt;/b&gt;&amp;nbsp; openai.GPT5; parseValidatorResponse" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;whiteSpace=wrap;overflow=hidden;fontSize=11;" vertex="1" parent="e_llm_generator (server/llm_generator)"><mxGeometry y="78" width="460" height="26" as="geometry"/></mxCell><mxCell id="c92" value="&lt;b&gt;chatCompletionWithRetry&lt;/b&gt;&amp;nbsp; isRetryableOpenAIError / isRetryableStatus; withOpenAIErrorCode prefixes openai_code=&amp;lt;code&amp;gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;whiteSpace=wrap;overflow=hidden;fontSize=11;" vertex="1" parent="e_llm_generator (server/llm_generator)"><mxGeometry y="104" width="460" height="48" as="geometry"/></mxCell><mxCell id="c93" value="&lt;b&gt;VERSION&lt;/b&gt;&amp;nbsp; stamped into problems.generator for WORD problems" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;whiteSpace=wrap;overflow=hidden;fontSize=11;" vertex="1" parent="e_llm_generator (server/llm_generator)"><mxGeometry y="152" width="460" height="26" as="geometry"/></mxCell><mxCell id="e_mathcore (leaf kernel, no api/generator imports)" value="mathcore (leaf kernel, no api/generator imports)" style="swimlane;html=1;fontStyle=1;fontSize=13;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#f3f9f2;rounded=1;arcSize=6;shadow=1;" vertex="1" parent="1"><mxGeometry x="1720" y="1164" width="460" height="222" as="geometry"/></mxCell><mxCell id="c94" value="&lt;b&gt;AdmitExpression&lt;/b&gt;&amp;nbsp; stamping.go; ADMISSION_FUNNEL stages [0]-[2.5]; [3] / [3.5] are separate functions" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;whiteSpace=wrap;overflow=hidden;fontSize=11;" vertex="1" parent="e_mathcore (leaf kernel, no api/generator imports)"><mxGeometry y="30" width="460" height="48" as="geometry"/></mxCell><mxCell id="c95" value="&lt;b&gt;ComputeProblemDifficulty&lt;/b&gt;&amp;nbsp; difficulty.go; + ComputeDifficultyBreakdown, TargetDifficultyRange, Max/MinDiffForBitmap" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;whiteSpace=wrap;overflow=hidden;fontSize=11;" vertex="1" parent="e_mathcore (leaf kernel, no api/generator imports)"><mxGeometry y="78" width="460" height="48" as="geometry"/></mxCell><mxCell id="c96" value="&lt;b&gt;eval&lt;/b&gt;&amp;nbsp; Eval / EvalTokens / EvalTokensNaiveLTR (requiresPEMDAS); AnswersEquivalent" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;whiteSpace=wrap;overflow=hidden;fontSize=11;" vertex="1" parent="e_mathcore (leaf kernel, no api/generator imports)"><mxGeometry y="126" width="460" height="48" as="geometry"/></mxCell><mxCell id="c97" value="&lt;b&gt;bitmaps&lt;/b&gt;&amp;nbsp; ValidBitmap / EnumerateValidBitmaps; ProblemType iota + ProblemTypeToFeatures" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;whiteSpace=wrap;overflow=hidden;fontSize=11;" vertex="1" parent="e_mathcore (leaf kernel, no api/generator imports)"><mxGeometry y="174" width="460" height="48" as="geometry"/></mxCell><mxCell id="e_MATHCORE_AST (ast.go)" value="MATHCORE_AST (ast.go)" style="swimlane;html=1;fontStyle=1;fontSize=13;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#f3f9f2;rounded=1;arcSize=6;shadow=1;" vertex="1" parent="1"><mxGeometry x="1720" y="1422" width="460" height="664" as="geometry"/></mxCell><mxCell id="c98" value="&lt;b&gt;what it is&lt;/b&gt;&amp;nbsp; the expression tree behind every problem. heuristic_generator builds one answer-first, Render flattens it to the ASCII stored in problems.expression, and answer-checking re-parses that ASCII back into this same tree" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;whiteSpace=wrap;overflow=hidden;fontSize=11;" vertex="1" parent="e_MATHCORE_AST (ast.go)"><mxGeometry y="30" width="460" height="92" as="geometry"/></mxCell><mxCell id="c99" value="&lt;b&gt;example&lt;/b&gt;&amp;nbsp; &amp;quot;(3 + 5) * 4 = ?&amp;quot; is Equation{ LHS: BinaryExpr{ Op:*, L: Paren{ BinaryExpr{ Op:+, Num 3, Num 5 } }, R: Num 4 }, RHS: Missing }" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;whiteSpace=wrap;overflow=hidden;fontSize=11;" vertex="1" parent="e_MATHCORE_AST (ast.go)"><mxGeometry y="122" width="460" height="48" as="geometry"/></mxCell><mxCell id="c100" value="&lt;b&gt;Num&lt;/b&gt;&amp;nbsp; a number literal held as an exact rational (big.Rat), so 1/3 is never 0.333...; flags remember how to display it, not what it's worth: IsDecimal (12.0 vs 12), IsPercent (25% vs 0.25), IsFraction (3/4 vs 0.75); Raw keeps a spelling the value can't reproduce, like unreduced 6/8" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;whiteSpace=wrap;overflow=hidden;fontSize=11;" vertex="1" parent="e_MATHCORE_AST (ast.go)"><mxGeometry y="170" width="460" height="92" as="geometry"/></mxCell><mxCell id="c101" value="&lt;b&gt;Missing&lt;/b&gt;&amp;nbsp; the '?' blank the student solves for" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;whiteSpace=wrap;overflow=hidden;fontSize=11;" vertex="1" parent="e_MATHCORE_AST (ast.go)"><mxGeometry y="262" width="460" height="26" as="geometry"/></mxCell><mxCell id="c102" value="&lt;b&gt;Var&lt;/b&gt;&amp;nbsp; a variable letter like x; HasCoefficient means it renders glued to its number: 3x, not 3 * x" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;whiteSpace=wrap;overflow=hidden;fontSize=11;" vertex="1" parent="e_MATHCORE_AST (ast.go)"><mxGeometry y="288" width="460" height="48" as="geometry"/></mxCell><mxCell id="c103" value="&lt;b&gt;BinaryExpr&lt;/b&gt;&amp;nbsp; one operator and two operands (L Op R; Op is + - * /); nests to form larger expressions" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;whiteSpace=wrap;overflow=hidden;fontSize=11;" vertex="1" parent="e_MATHCORE_AST (ast.go)"><mxGeometry y="336" width="460" height="48" as="geometry"/></mxCell><mxCell id="c104" value="&lt;b&gt;Paren&lt;/b&gt;&amp;nbsp; parentheses the student must see. Kept as a real node because (3 + 5) * 4 and 3 + 5 * 4 are different problems (PEMDAS)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;whiteSpace=wrap;overflow=hidden;fontSize=11;" vertex="1" parent="e_MATHCORE_AST (ast.go)"><mxGeometry y="384" width="460" height="48" as="geometry"/></mxCell><mxCell id="c105" value="&lt;b&gt;Equation&lt;/b&gt;&amp;nbsp; top-level LHS = RHS, used for variable and missing-value problems" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;whiteSpace=wrap;overflow=hidden;fontSize=11;" vertex="1" parent="e_MATHCORE_AST (ast.go)"><mxGeometry y="432" width="460" height="48" as="geometry"/></mxCell><mxCell id="c106" value="&lt;b&gt;Render&lt;/b&gt;&amp;nbsp; walks the tree into canonical ASCII: operators spaced (a + b); division printed as the obelus (6 ÷ 2) so it can't be read as the fraction slash (3/8 stays a literal); a leading percent factor prints as &amp;quot;25% of 80&amp;quot;; parens auto-inserted anywhere infix precedence would re-parse the tree differently" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;whiteSpace=wrap;overflow=hidden;fontSize=11;" vertex="1" parent="e_MATHCORE_AST (ast.go)"><mxGeometry y="480" width="460" height="114" as="geometry"/></mxCell><mxCell id="c107" value="&lt;b&gt;the guarantee&lt;/b&gt;&amp;nbsp; Parse(Render(tree)) rebuilds the same tree and Eval folds it to the same answer, so problems can live as plain text in the DB yet be re-checked exactly" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;whiteSpace=wrap;overflow=hidden;fontSize=11;" vertex="1" parent="e_MATHCORE_AST (ast.go)"><mxGeometry y="594" width="460" height="70" as="geometry"/></mxCell><mxCell id="c108" value="BACKGROUND JOBS (systemd + manual)" style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="2280" y="40" width="520" height="30" as="geometry"/></mxCell><mxCell id="e_deploy/update.sh (manual deploy)" value="deploy/update.sh (manual deploy)" style="swimlane;html=1;fontStyle=1;fontSize=13;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;swimlaneFillColor=#fdf1f0;rounded=1;arcSize=6;shadow=1;" vertex="1" parent="1"><mxGeometry x="2280" y="90" width="460" height="270" as="geometry"/></mxCell><mxCell id="c109" value="&lt;b&gt;preflight&lt;/b&gt;&amp;nbsp; conf.json api_port must match nginx proxy_pass; api_host = https://mikeymath.org; maintenance-flag path cross-check" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;whiteSpace=wrap;overflow=hidden;fontSize=11;" vertex="1" parent="e_deploy/update.sh (manual deploy)"><mxGeometry y="30" width="460" height="48" as="geometry"/></mxCell><mxCell id="c110" value="&lt;b&gt;build&lt;/b&gt;&amp;nbsp; make; build-web stages web/build.next then swaps, so a failed build leaves the live site untouched" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;whiteSpace=wrap;overflow=hidden;fontSize=11;" vertex="1" parent="e_deploy/update.sh (manual deploy)"><mxGeometry y="78" width="460" height="48" as="geometry"/></mxCell><mxCell id="c111" value="&lt;b&gt;maintenance&lt;/b&gt;&amp;nbsp; raises /var/www/mathgame/maintenance.on for the restart; a failed deploy ends on the maintenance page (set -e)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;whiteSpace=wrap;overflow=hidden;fontSize=11;" vertex="1" parent="e_deploy/update.sh (manual deploy)"><mxGeometry y="126" width="460" height="48" as="geometry"/></mxCell><mxCell id="c112" value="&lt;b&gt;sync + restart&lt;/b&gt;&amp;nbsp; unit files -&amp;gt; /etc/systemd/system, daemon-reload; restart mathgame-api + all timers; nginx -t then reload" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;whiteSpace=wrap;overflow=hidden;fontSize=11;" vertex="1" parent="e_deploy/update.sh (manual deploy)"><mxGeometry y="174" width="460" height="48" as="geometry"/></mxCell><mxCell id="c113" value="&lt;b&gt;smoke&lt;/b&gt;&amp;nbsp; loopback readiness (401 on 127.0.0.1:api_port), then front-door curls; failure re-raises maintenance" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;whiteSpace=wrap;overflow=hidden;fontSize=11;" vertex="1" parent="e_deploy/update.sh (manual deploy)"><mxGeometry y="222" width="460" height="48" as="geometry"/></mxCell><mxCell id="e_mathgame-compress-events (03:00)" value="mathgame-compress-events (03:00)" style="swimlane;html=1;fontStyle=1;fontSize=13;childLayout=stackLayout;